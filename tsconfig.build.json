{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "experimentalDecorators": true,
        "allowImportingTsExtensions": true,
        "types": ["node"]
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}
