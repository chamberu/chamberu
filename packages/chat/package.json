{
    "name": "@chamvi/chat",
    "version": "0.0.0",
    "type": "module",
    "description": "Chat channels for chamvi: Slack, Teams, Discord and every other Chat SDK adapter as triggers, approval cards and a reply tool.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/chat"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "chat",
        "slack",
        "teams",
        "discord",
        "channel"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/core": "^0.1.0",
        "@chamvi/http": "^0.1.0",
        "@chamvi/test-kit": "^0.1.0",
        "@chat-adapter/state-memory": "^4.43.0",
        "ai": "^7.0.143",
        "chat": "^4.43.0"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.1.0",
        "@chamvi/http": "^0.1.0",
        "ai": "^7",
        "chat": "^4.43.0"
    }
}
