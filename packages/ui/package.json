{
    "name": "@chamvi/ui",
    "version": "0.1.0",
    "type": "module",
    "description": "The chamvi dashboard: watch runs live, answer approvals, inspect agent state and schedules, served by @chamvi/http.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/ui"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build:app": "vite build",
        "build": "npm run build:types && npm run build:js && npm run build:app",
        "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p app/tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "test:e2e": "playwright test",
        "dev": "vite"
    },
    "nx": {
        "targets": {
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "keywords": [
        "chamvi",
        "dashboard",
        "ui",
        "vue",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@authup/client-web-kit": "1.0.0-beta.71",
        "@chamvi/core": "^0.1.0",
        "@chamvi/http": "^0.1.0",
        "@chamvi/test-kit": "^0.1.0",
        "@ebec/core": "^1.3.2",
        "@fontsource/bricolage-grotesque": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@ilingo/validup-vue": "^1.2.0",
        "@ilingo/vue": "^6.1.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@validup/vue": "^2.0.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vuecs/button": "^1.4.2",
        "@vuecs/core": "^3.6.0",
        "@vuecs/countdown": "^2.1.1",
        "@vuecs/design": "^1.2.1",
        "@vuecs/elements": "^1.5.1",
        "@vuecs/forms": "^5.4.2",
        "@vuecs/icon": "^1.1.1",
        "@vuecs/icons-lucide": "^1.3.1",
        "@vuecs/link": "^2.1.2",
        "@vuecs/list": "^1.3.0",
        "@vuecs/locale": "^1.1.2",
        "@vuecs/overlays": "^1.3.1",
        "@vuecs/pagination": "^2.2.1",
        "@vuecs/placeholder": "^1.1.1",
        "@vuecs/table": "^1.6.2",
        "@vuecs/theme-tailwind": "^6.5.0",
        "@vuecs/timeago": "^2.2.1",
        "@vuecs/tree": "^1.0.0",
        "@vueuse/core": "^14.0.0",
        "ai": "^7.0.143",
        "ilingo": "^6.2.0",
        "pinia": "^4.1.0",
        "routup": "^6.1.0",
        "smob": "^1.6.2",
        "socket.io-client": "^4.8.4",
        "tailwindcss": "^4.3.3",
        "validup": "^2.0.1",
        "vite": "^8.3.5",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.13",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.1.0",
        "@chamvi/http": "^0.1.0"
    }
}
