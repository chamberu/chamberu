{
    "name": "@chamberu/test-kit",
    "version": "0.1.0",
    "type": "module",
    "description": "Test helpers for chamberu: a controllable clock and the store contract suite.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/chamberu/chamberu.git",
        "directory": "packages/test-kit"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamberu",
        "testing",
        "store",
        "contract"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "devDependencies": {
        "@chamberu/core": "^0.1.0"
    },
    "peerDependencies": {
        "@chamberu/core": "^0.1.0",
        "vitest": "^5"
    }
}
