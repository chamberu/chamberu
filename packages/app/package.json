{
    "name": "@chamvi/app",
    "version": "0.1.0",
    "type": "module",
    "description": "Boots chamvi agents as an app: config, store, engine, scheduler and HTTP as orkos modules.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/app"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./github": {
            "types": "./dist/github.d.mts",
            "import": "./dist/github.mjs"
        },
        "./sandbox": {
            "types": "./dist/sandbox.d.mts",
            "import": "./dist/sandbox.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "app",
        "agents",
        "orkos"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@chamvi/core": "^0.1.0",
        "@chamvi/http": "^0.1.0",
        "@chamvi/scheduler": "^0.1.0",
        "@chamvi/store-typeorm": "^0.1.0",
        "eldin": "^1.3.0",
        "envix": "^1.5.0",
        "orkos": "^1.1.1",
        "routup": "^6.1.0",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@ai-sdk/anthropic": "^4.0.85",
        "@authup/core-http-kit": "^1.0.0-beta.70",
        "@authup/server-adapter-kit": "^1.0.0-beta.70",
        "@chamvi/github": "^0.1.0",
        "@chamvi/notify-github": "^0.1.0",
        "@chamvi/notify-openclaw": "^0.1.0",
        "@chamvi/sandbox": "^0.1.0",
        "@chamvi/sandbox-docker": "^0.1.0",
        "@chamvi/sandbox-k8s": "^0.1.0",
        "@chamvi/sandbox-local": "^0.1.0",
        "@chamvi/test-kit": "^0.1.0",
        "@chamvi/ui": "^0.1.0",
        "@swc/core": "^1.16.18",
        "@testcontainers/postgresql": "^12.2.1",
        "ai": "^7.0.143",
        "pg": "^8.23.1",
        "typeorm": "^1.1.2",
        "typeorm-extension": "^4.3.0",
        "unplugin-swc": "^2.0.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@ai-sdk/anthropic": "^4",
        "@ai-sdk/google": "^4",
        "@ai-sdk/mistral": "^4",
        "@ai-sdk/openai": "^4",
        "@ai-sdk/xai": "^5",
        "@authup/core-http-kit": "^1.0.0-beta.70",
        "@authup/server-adapter-kit": "^1.0.0-beta.70",
        "@chamvi/github": "^0.1.0",
        "@chamvi/notify-github": "^0.1.0",
        "@chamvi/notify-openclaw": "^0.1.0",
        "@chamvi/sandbox": "^0.1.0",
        "@chamvi/sandbox-docker": "^0.1.0",
        "@chamvi/sandbox-k8s": "^0.1.0",
        "@chamvi/sandbox-local": "^0.1.0",
        "@chamvi/ui": "^0.1.0",
        "ai": "^7.0.143",
        "pg": "^8",
        "typeorm": "^1.1.2"
    },
    "peerDependenciesMeta": {
