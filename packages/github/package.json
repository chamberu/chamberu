{
    "name": "@chamberu/github",
    "version": "0.1.0",
    "type": "module",
    "description": "GitHub App webhooks and tools for chamberu agents.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamberu.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamberu/chamberu.git",
        "directory": "packages/github"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamberu",
        "github",
        "github-app",
        "webhook",
        "octokit"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@ebec/http": "^4.3.2",
        "@octokit/core": "^7.0.8",
        "@octokit/plugin-paginate-rest": "^16.0.0",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamberu/core": "^0.1.0",
        "@chamberu/http": "^0.1.0",
        "@chamberu/test-kit": "^0.1.0",
        "ai": "^7.0.143",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamberu/core": "^0.1.0",
        "@chamberu/http": "^0.1.0",
        "ai": "^7"
    }
}
