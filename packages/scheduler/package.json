{
    "name": "@chamberu/scheduler",
    "version": "0.1.0",
    "type": "module",
    "description": "Fires chamberu cron triggers once per tick across replicas, on hubwire.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamberu.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamberu/chamberu.git",
        "directory": "packages/scheduler"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamberu",
        "cron",
        "scheduler",
        "hubwire"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "hubwire": "^0.2.2"
    },
    "devDependencies": {
        "@chamberu/core": "^0.1.0",
        "@chamberu/test-kit": "^0.1.0",
        "@hubwire/test": "^0.1.2",
        "ai": "^7.0.143",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamberu/core": "^0.1.0"
    }
}
